# Copy to bot/.env and fill in. Never commit bot/.env.
# Turn on Discord Developer Mode (Settings > Advanced) to copy IDs.

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Long-press the #option-plays channel -> Copy Channel ID
SIGNAL_CHANNEL_ID=

# Signal poster's Discord user ID (long-press their name -> Copy User ID).
# Using a webhook into your own server instead? Put the webhook's ID here.
SIGNAL_AUTHOR_IDS=

# YOUR Discord user ID: order plans are DMed to you; only your ✅ places them.
APPROVER_USER_ID=

# Robinhood Agentic account number (full number)
ROBINHOOD_ACCOUNT_NUMBER=

# Optional
# APPROVAL_TIMEOUT_S=120
# CLAUDE_BIN=claude
# CLAUDE_TIMEOUT_S=180
